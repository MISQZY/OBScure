# Copy to .env (already git-ignored) and fill in for local builds.
# Register an app at https://dev.twitch.tv/console/apps — OAuth Redirect URL:
# http://localhost:47891/callback/twitch
# This becomes the default Client ID baked into the build; users can still
# override it with their own in Settings > Twitch.
VITE_TWITCH_CLIENT_ID=
